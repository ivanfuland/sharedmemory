# everos-mcp 运行时 env 模板。unit 的 EnvironmentFile 指向本目录下的
# `everos-mcp.env`（%h/projects/sharedmemory/infra/everos-mcp/everos-mcp.env，
# 见 everos-mcp.service）——复制本文件为同目录下的 `everos-mcp.env`
# （已 gitignore：infra/everos-mcp/*.env，不进仓）后填真实值，chmod 600。
#
# systemd EnvironmentFile 格式：KEY=value（无 export、无 ~ 展开——本模板全部
# 用绝对路径占位，部署时替换为真实绝对路径）。
#
# 全部字段均为占位值，本文件不含任何真实端口/路径/密钥字面量（PUBLIC 仓纪律）。

# 监听端口（绑 127.0.0.1，仅本机访问；本 unit 自身不暴露公网）
EVEROS_MCP_PORT=PORT_HERE

# 鉴权 bearer：openssl rand -hex 32。三端 MCP 客户端注册时用同一个值。缺失则拒启（fail-fast）。
EVEROS_MCP_TOKEN=REPLACE_WITH_SECRET_BEARER_TOKEN
# 可选：客户端身份标签（进访问日志 token_id），缺省为 "shadow"
EVEROS_MCP_TOKEN_ID=REPLACE_WITH_TOKEN_ID

# EverOS 上游（必须是 loopback：127.0.0.0/8 或字面量 localhost）
EVEROS_BASE_URL=http://127.0.0.1:EVEROS_PORT_HERE
EVEROS_AGENT_ID=REPLACE_WITH_AGENT_ID

# 本地 Infinity 推理服务（必须是 loopback）
INFINITY_BASE=http://127.0.0.1:INFINITY_PORT_HERE
# cc-infinity 容器名（scorer.py 的 pin 采集经 docker inspect/exec 打这个容器）
INFINITY_CONTAINER=REPLACE_WITH_CONTAINER_NAME

# 账本根目录（必须真实存在、非 symlink、owner 是运行本 unit 的用户；0700）
SHADOW_LEDGER_DIR=/REPLACE/WITH/ABSOLUTE/LEDGER/DIR

# 模型 id（与 cc-infinity 实际托管的模型一致）
EVEROS_EMBED_MODEL=BAAI/bge-m3
EVEROS_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# pin 文件（everos_prod_instance.sh 写的两因子原文，本 unit 只读不重算）
EVEROS_PIN_FILE=/REPLACE/WITH/ABSOLUTE/PIN/FILE/PATH
# EverOS 实例目录（.cases/ + skills/，lib_counts 采集用）
EVEROS_INSTANCE_DIR=/REPLACE/WITH/ABSOLUTE/INSTANCE/DIR

# 可选：库存为空是预期内状态时设为 1（跳过启动探针的空库判定）
# EVEROS_MCP_EXPECT_EMPTY=1

# 可选：运维告警旁路（同 server.py 的 _alert，缺失则只记 journal，不发 TG）
# TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
# TELEGRAM_CHAT_ID=REPLACE_WITH_TELEGRAM_CHAT_ID

# 不要在此文件设置 SHADOW_TRAFFIC_CLASS / SHADOW_FAULT ——两者是测试/故障注入
# 专用旋钮（见 scripts/everos_mcp_bench.py、scripts/everos_mcp_faults.sh），
# 生产 unit 留空即走默认值 real / 无故障注入。
