# cass-mcp 运行时 env 模板。复制为 cass-mcp.env（gitignored）后填 bearer。
# systemd EnvironmentFile 格式：KEY=value（无 export、无 ~ 展开，用绝对路径）。
# deploy.sh 会在缺 cass-mcp.env 时自动从本模板生成并灌入随机 bearer。

# 鉴权 bearer：openssl rand -hex 32。三端 MCP 客户端注册时用同一个值。缺失则 server 拒启（fail-fast）。
CASS_MCP_BEARER=__REPLACE_WITH_SECRET__
# 客户端身份标签（进访问日志 token_id）
CASS_MCP_TOKEN_ID=hub

# CASS fork 二进制（symlink 到 cass-infinity）
CASS_BIN=/home/ivan/.local/bin/cass
# canonical 库 + 本地 Infinity（config.py 也会 setdefault，这里显式更清晰）
CASS_DATA_DIR=/home/ivan/.local/share/coding-agent-search
CASS_INFINITY_URL=http://127.0.0.1:7997

# 监听端口（绑 127.0.0.1；外网经 tailscale serve 代理，见 README）
CASS_MCP_PORT=7788
# 访问日志绝对路径（gitignored）
CASS_MCP_AUDIT=/home/ivan/projects/sharedmemory/infra/cass-mcp/cass_audit.log
